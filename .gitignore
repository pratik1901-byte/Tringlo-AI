# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Everything in this project is committed EXCEPT secrets and generated output.
# Secrets live only in .env.local on each machine; generated folders are rebuilt
# by npm install / next build / the Flutter toolchain.

# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem

# ---- Dependencies (reinstalled with npm install) ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Generated build output ----
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts
# Compiled Flutter web app, produced from flutter_app/ by scripts/build-web.mjs
/public/app/
/flutter_app/build/
/flutter_app/.dart_tool/
/flutter_app/ios/Flutter/ephemeral/
/flutter_app/windows/flutter/ephemeral/
/flutter_app/android/.gradle/

# ---- Logs and OS noise ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
.vercel

# ---- Local data (committed on purpose; see data/) ----
data/database.json.tmp

# Copies of .env.local kept as backups: these hold live keys.
data/backups/env.local*
*.env.bak
