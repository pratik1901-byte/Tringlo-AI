# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local call database (real customer data — never commit)
/data/database.json
/data/database.json.tmp
/data/recordings/
# Backups of the local database: customer data and password hashes.
/data/backups/

# Flutter
/flutter_app/build/
/flutter_app/.dart_tool/
/flutter_app/.flutter-plugins-dependencies
# Compiled Flutter web app, produced from flutter_app/ by scripts/build-web.mjs
/public/app/

# Per-install workspace setup applied at startup (Sarvam ids, no secrets)
data/workspace-setup.json

# Installed agent skills (local dev tooling, not application code)
/.claude/skills/
