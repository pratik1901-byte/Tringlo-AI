# ============================================================
# Sarvam Voice Agents — server-side only
# Never prefix any of these with NEXT_PUBLIC_: they are secrets,
# and the browser must never receive them.
# ============================================================

SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# The Voice Agent app that runs the conversation.
SARVAM_APP_ID=
SARVAM_APP_VERSION=4
SARVAM_APP_TYPE=agent

# Vobiz telephony connection and the number calls are placed from.
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# Display name used in the opening line and as the speaker label on transcripts.
SARVAM_AGENT_NAME=Priya

# Set to "true" when the agent's own entry node already greets the customer,
# so Dialo does not add a second greeting on top of it.
SARVAM_OMIT_INITIAL_BOT_MESSAGE=

# Agent variables the app declares, comma separated. Sarvam rejects the whole
# request if it receives a name the app does not declare, so leave this unset to
# use Dialo's known-good default list, and only extend it after adding the
# matching fields in the Sarvam app.
SARVAM_AGENT_VARIABLES=

# ============================================================
# Application
# ============================================================

# Public https URL Sarvam posts call results to. A URL registered at runtime by
# the dev supervisor takes precedence over this. Without either, the call is placed
# but the outcome never arrives, so Dialo reports the configuration as incomplete.
# Local development needs a tunnel (ngrok, cloudflared) pointing here.
WEBHOOK_BASE_URL=

# Unguessable token appended to the webhook URL Sarvam is given. Sarvam's
# outbound webhook config offers no signing secret or custom headers, so the URL
# is the only place a secret can live. At least 16 characters. Set it while no
# calls are in flight — an in-flight call was registered with the old URL.

# Shared secret the dev launcher uses to register the tunnel hostname at runtime.
# Without it that endpoint accepts only unproxied local requests.
DIALO_INTERNAL_SECRET=

# Enables /api/test-hooks, which can put a follow-up into states the public API
# cannot reach. Refused outright in a production build. Leave unset.
DIALO_TEST_HOOKS=

# Set to "true" to stop the scheduler placing callbacks on this instance.
DIALO_DISABLE_SCHEDULER=

# Hard stop on all outbound calling. Set to "true" for any test run: it blocks
# calls outright rather than relying on an unreachable webhook URL, which is not
# a reliable way to stop a call from being placed.
DIALO_BLOCK_OUTBOUND_CALLS=

# Dialo probes the webhook URL before every call and refuses to dial if the result could
# not get back, because the call would still connect and its outcome would be
# lost. Set this to "true" only if you deliberately want to dial anyway.
ALLOW_CALLS_WITHOUT_WEBHOOK=

# Shared secret the Voice Agent must send to query company knowledge mid-call at
# /api/integrations/sarvam/rag. Without it that endpoint accepts the Sarvam API
# key instead; with neither set, the endpoint refuses every request.
DIALO_INTERNAL_SECRET=

# ------------------------------------------------------------------
# Email (password-reset codes, interested-lead alerts, daily summary)
#
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification) and use it as SMTP_PASS. Never your normal
# Google password. Server-side only — never prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
